.game-screen { flex-grow: 1; padding: 20px; background-color: rgb(18, 27, 45); align-items: center; position: relative; }
.top-bar { width: 100%; height: 56px; flex-direction: row; align-items: center; }
.question-number { font-size: 30px; color: rgb(255, 207, 80); -unity-font-style: bold; }
.score-caption { margin-left: auto; margin-right: 8px; color: rgb(174, 190, 217); }
.score { font-size: 30px; color: white; -unity-font-style: bold; }
.question-panel { min-height: 74px; width: 100%; justify-content: center; align-items: center; }
.question { font-size: 24px; color: white; -unity-text-align: middle-center; white-space: normal; }
.grid-container { flex-direction: row; flex-wrap: wrap; justify-content: center; align-content: center; margin-top: 8px; margin-bottom: 14px; }

.crossword-cell { width: 40px; height: 40px; margin: 1px; padding: 0; background-color: white; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(93, 112, 145); border-right-color: rgb(93, 112, 145); border-top-color: rgb(93, 112, 145); border-bottom-color: rgb(93, 112, 145); align-items: center; justify-content: center; }
.crossword-cell.blocked { visibility: hidden; }
.crossword-cell.in-word { background-color: rgb(214, 226, 248); }
.crossword-cell.selected { margin: 0; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(255, 197, 55); border-right-color: rgb(255, 197, 55); border-top-color: rgb(255, 197, 55); border-bottom-color: rgb(255, 197, 55); }
.crossword-cell.correct { background-color: rgb(157, 226, 174); }
.crossword-cell.incorrect { background-color: rgb(255, 180, 177); }

.cell-number { position: absolute; left: 2px; top: 1px; margin: 0; padding: 0; font-size: 9px; color: rgb(93, 112, 145); }
.cell-letter { margin: 0; padding: 0; font-size: 22px; -unity-font-style: bold; color: rgb(22, 34, 55); -unity-text-align: middle-center; }

.bottom-bar { width: 100%; height: 58px; flex-direction: row; justify-content: center; }
.bottom-bar Button { min-width: 150px; margin-left: 6px; margin-right: 6px; font-size: 14px; -unity-font-style: bold; background-color: rgb(240, 244, 252); color: rgb(22, 34, 55); border-width: 0; border-radius: 6px; }
.bottom-bar Button:hover { background-color: rgb(255, 224, 130); }

.win-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 16, 30, 0.85); align-items: center; justify-content: center; }
.win-panel { width: 420px; padding: 28px; background-color: rgb(24, 35, 58); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 207, 80); border-right-color: rgb(255, 207, 80); border-top-color: rgb(255, 207, 80); border-bottom-color: rgb(255, 207, 80); border-radius: 12px; align-items: center; opacity: 1; scale: 1; transition-property: opacity, scale; transition-duration: 0.25s; }
.win-panel-hidden { opacity: 0; scale: 0.85; }
.win-panel #win-title { font-size: 32px; color: rgb(255, 207, 80); -unity-font-style: bold; margin-bottom: 8px; }
.win-panel #win-text { font-size: 20px; color: white; margin-bottom: 4px; }
.win-panel #win-score { font-size: 26px; color: white; -unity-font-style: bold; margin-bottom: 2px; }
.win-panel #win-best { font-size: 16px; color: rgb(174, 190, 217); margin-bottom: 16px; }
.win-panel #restart-button { min-width: 220px; height: 48px; font-size: 18px; -unity-font-style: bold; background-color: rgb(255, 207, 80); color: rgb(22, 34, 55); border-width: 0; border-radius: 8px; }
.win-panel #restart-button:hover { background-color: rgb(255, 224, 130); }
