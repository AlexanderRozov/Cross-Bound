<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" class="game-screen">
        <ui:VisualElement class="top-bar">
            <ui:Label name="question-number" text="1" class="question-number" />
            <ui:Label text="ОЧКИ" class="score-caption" />
            <ui:Label name="score" text="0" class="score" />
        </ui:VisualElement>
        <ui:VisualElement class="question-panel"><ui:Label name="question" text="Загрузка кроссворда…" class="question" /></ui:VisualElement>
        <ui:VisualElement name="grid-container" class="grid-container" />
        <ui:VisualElement class="bottom-bar">
            <ui:Button name="delete-button" text="УДАЛИТЬ" />
            <ui:Button name="hint-button" text="ПОДСКАЗКА" />
            <ui:Button name="submit-button" text="ПРОВЕРИТЬ" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
